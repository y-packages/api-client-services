{
    "kind": "discovery#restDescription",
    "discoveryVersion": "v1",
    "id": "secretmanager:v1",
    "name": "secretmanager",
    "canonicalName": "SecretManager",
    "version": "v1",
    "title": "YakNet Secret Manager API",
    "description": "AES-256 şifreli gizli anahtar kasası ve sürüm döndürme servisi.",
    "ownerDomain": "yakhub.com.tr",
    "ownerName": "YakNet",
    "protocol": "rest",
    "rootUrl": "https://developer-console.yakhub.com.tr/",
    "servicePath": "api/cloud/secrets",
    "auth": {
        "apiKey": {
            "header": "X-API-Key",
            "prefix": "yk_live_"
        },
        "oauth2Client": {
            "clientIdHeader": "X-Client-ID",
            "clientSecretHeader": "X-Client-Secret"
        }
    },
    "schemas": {
        "SecretVersionInfo": {
            "id": "SecretVersionInfo",
            "type": "object",
            "properties": {
                "version": {
                    "type": "integer"
                },
                "state": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                }
            }
        },
        "Secret": {
            "id": "Secret",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "resource_name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "latest_version": {
                    "type": "integer"
                },
                "expires_at": {
                    "type": "string"
                },
                "versions": {
                    "type": "array",
                    "items": {
                        "$ref": "SecretVersionInfo"
                    }
                },
                "created_at": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "SecretsListResponse": {
            "id": "SecretsListResponse",
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "project": {
                    "type": "string"
                },
                "secrets": {
                    "type": "array",
                    "items": {
                        "$ref": "Secret"
                    }
                }
            }
        },
        "CreateSecretRequest": {
            "id": "CreateSecretRequest",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "secret_value": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "expires_at": {
                    "type": "string"
                }
            }
        },
        "SecretResponse": {
            "id": "SecretResponse",
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "secret": {
                    "$ref": "Secret"
                }
            }
        },
        "AddSecretVersionRequest": {
            "id": "AddSecretVersionRequest",
            "type": "object",
            "properties": {
                "secret_value": {
                    "type": "string"
                }
            }
        },
        "AddSecretVersionResponse": {
            "id": "AddSecretVersionResponse",
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "secret": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                },
                "state": {
                    "type": "string"
                }
            }
        },
        "AccessSecretVersionResponse": {
            "id": "AccessSecretVersionResponse",
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "secret": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                },
                "payload": {
                    "type": "string"
                }
            }
        },
        "DeleteSecretResponse": {
            "id": "DeleteSecretResponse",
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "deleted": {
                    "type": "string"
                }
            }
        }
    },
    "resources": {
        "secrets": {
            "methods": {
                "listSecrets": {
                    "id": "secretmanager.secrets.listSecrets",
                    "path": "",
                    "httpMethod": "GET",
                    "description": "Kasadaki gizli anahtarların meta verilerini listeler.",
                    "parameters": [],
                    "response": {
                        "$ref": "SecretsListResponse"
                    }
                },
                "create": {
                    "id": "secretmanager.secrets.create",
                    "path": "",
                    "httpMethod": "POST",
                    "description": "AES-256 şifreli yeni bir gizli anahtar oluşturur.",
                    "parameters": [],
                    "request": {
                        "$ref": "CreateSecretRequest"
                    },
                    "response": {
                        "$ref": "SecretResponse"
                    }
                },
                "get": {
                    "id": "secretmanager.secrets.get",
                    "path": "/{name}",
                    "httpMethod": "GET",
                    "description": "Gizli anahtarın meta verisini ve sürüm listesini döndürür.",
                    "parameters": {
                        "name": {
                            "type": "string",
                            "location": "path",
                            "required": true
                        }
                    },
                    "response": {
                        "$ref": "SecretResponse"
                    }
                },
                "access": {
                    "id": "secretmanager.secrets.access",
                    "path": "/{name}/access",
                    "httpMethod": "GET",
                    "description": "Gizli anahtarın şifresini çözer ve düz metin değerini döndürür.",
                    "parameters": {
                        "name": {
                            "type": "string",
                            "location": "path",
                            "required": true
                        },
                        "version": {
                            "type": "string",
                            "location": "query",
                            "required": false
                        }
                    },
                    "response": {
                        "$ref": "AccessSecretVersionResponse"
                    }
                },
                "delete": {
                    "id": "secretmanager.secrets.delete",
                    "path": "/{name}",
                    "httpMethod": "DELETE",
                    "description": "Gizli anahtarı ve tüm sürümlerini siler.",
                    "parameters": {
                        "name": {
                            "type": "string",
                            "location": "path",
                            "required": true
                        }
                    },
                    "response": {
                        "$ref": "DeleteSecretResponse"
                    }
                }
            }
        },
        "versions": {
            "methods": {
                "add": {
                    "id": "secretmanager.versions.add",
                    "path": "/{name}/versions",
                    "httpMethod": "POST",
                    "description": "Mevcut bir gizli anahtara yeni şifreli sürüm ekler.",
                    "parameters": {
                        "name": {
                            "type": "string",
                            "location": "path",
                            "required": true
                        }
                    },
                    "request": {
                        "$ref": "AddSecretVersionRequest"
                    },
                    "response": {
                        "$ref": "AddSecretVersionResponse"
                    }
                }
            }
        }
    }
}
