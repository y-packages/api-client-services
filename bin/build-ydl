#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * YakNet API Client Services — Dynamic Link Library (.ydl) Compiler
 *
 * Compiles all 611+ SDK classes into a single high-performance binary (.ydl)
 * and generates IDE autocomplete stubs.
 */

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../dynlink/vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$loaded = false;
foreach ($autoloadPaths as $autoload) {
    if (file_exists($autoload)) {
        require_once $autoload;
        $loaded = true;
        break;
    }
}

if (!class_exists(\YakNet\DynLink\DynLink::class)) {
    // Attempt to register DynLink autoload directly from sibling folder if present
    $dynlinkSrc = __DIR__ . '/../../dynlink/src';
    if (is_dir($dynlinkSrc)) {
        spl_autoload_register(static function (string $class) use ($dynlinkSrc): void {
            $prefix = 'YakNet\\DynLink\\';
            if (str_starts_with($class, $prefix)) {
                $relative = substr($class, strlen($prefix));
                $file = $dynlinkSrc . '/' . str_replace('\\', '/', $relative) . '.php';
                if (file_exists($file)) {
                    require_once $file;
                }
            }
        });
    }
}

if (!class_exists(\YakNet\DynLink\DynLink::class)) {
    fwrite(STDERR, "❌ HATA: YakNet DynLink motoru bulunamadı. Lütfen 'yaknet/dynlink' kütüphanesini yükleyin.\n");
    exit(1);
}

use YakNet\DynLink\DynLink;

$rootDir = realpath(__DIR__ . '/..') ?: dirname(__DIR__);
$distDir = $rootDir . '/dist';
$stubsDir = $rootDir . '/stubs';
$targetYdl = $distDir . '/api-client-services.ydl';
$targetStubs = $stubsDir . '/api-client-services.stub.php';

if (!is_dir($distDir)) {
    mkdir($distDir, 0777, true);
}
if (!is_dir($stubsDir)) {
    mkdir($stubsDir, 0777, true);
}

echo "\033[1;36m====================================================================\033[0m\n";
echo "\033[1;32m  YakNet API Client Services — .ydl Binary Derleyici & Paketleyici   \033[0m\n";
echo "\033[1;36m====================================================================\033[0m\n\n";

echo "📦 Kaynak dizini taranıyor: {$rootDir}\n";
echo "⚙  Paketleme ayarları: GZIP sıkıştırma, VFS dinamik yükleme (fusion=OFF), Kod optimizasyonu=ON\n";

$startTime = microtime(true);

$packOptions = [
    'compression' => 'gzip',
    'fusion' => false,
    'optimize' => true,
    'obfuscate' => false,
    'generate_stubs' => $targetStubs,
    'excludes' => [
        '.git',
        '.github',
        'bin',
        'discovery',
        'generator',
        'tests',
        'vendor',
        '.phpunit.cache',
        'dist',
        'stubs',
        'build',
    ],
];

try {
    $bytes = DynLink::pack($rootDir, $targetYdl, $packOptions);
    $duration = round((microtime(true) - $startTime) * 1000, 2);
    $sizeKb = round($bytes / 1024, 2);

    echo "\n\033[1;32m✔ .ydl İkili Kütüphane başarıyla derlendi!\033[0m\n";
    echo "  • Çıktı Dosyası:    \033[1;34m{$targetYdl}\033[0m\n";
    echo "  • İkili Boyutu:     \033[1;33m{$sizeKb} KB\033[0m ({$bytes} bayt)\n";
    echo "  • Derleme Süresi:   {$duration} ms\n";

    if (file_exists($targetStubs)) {
        $stubsKb = round(filesize($targetStubs) / 1024, 2);
        echo "  • IDE / Tip Stubs:  \033[1;34m{$targetStubs}\033[0m ({$stubsKb} KB)\n";
    }

    // Doğu ve sağlamasını yap: Derlenen ikiliyi belleğe bağlayıp örnek sınıfları oluştur
    echo "\n🔍 Derlenen ikili doğrulanıyor (Self-Test)...\n";
    $testLib = DynLink::load($targetYdl, [
        'verify_checksum' => true,
        'auto_link' => true,
    ]);

    $client = new \YakNet\Api\Client(['api_key' => 'verify_token']);
    $turkiye = new \YakNet\Api\Turkiye($client);
    $a11y = new \YakNet\Api\Accessibility($client);

    echo "  ✔ Modül Adı:        {$testLib->getName()} (v{$testLib->getVersion()})\n";
    echo "  ✔ Sınıf Çözümleme:  YakNet\\Api\\Client -> " . get_class($client) . "\n";
    echo "  ✔ Servis Çözümleme: YakNet\\Api\\Turkiye -> " . $turkiye->serviceName . "\n";
    echo "  ✔ Model Çözümleme:  YakNet\\Api\\Accessibility -> " . $a11y->serviceName . "\n";

    echo "\n\033[1;32m🎉 BAŞARILI! 611 dosya yerine tek bir {$sizeKb} KB .ydl dosyası ile sıfır disk I/O sağlandı.\033[0m\n\n";
} catch (\Throwable $e) {
    fwrite(STDERR, "\n\033[1;31m❌ DERLEME HATASI: " . $e->getMessage() . "\033[0m\n");
    fwrite(STDERR, $e->getTraceAsString() . "\n");
    exit(1);
}
